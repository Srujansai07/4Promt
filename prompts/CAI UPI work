function PaymentModal({ isOpen, onClose, prompt }: { isOpen: boolean; onClose: () => void; prompt: typeof PROMPTS[0] | null }) {
    const [email, setEmail] = useState('')
    const [loading, setLoading] = useState(false)

    if (!isOpen || !prompt) return null

    const handlePayment = async () => {
        if (!email) {
            alert('Please enter your email')
            return
        }

        setLoading(true)
        const razorpayLink = getRazorpayLink(prompt.id, email)
        window.open(razorpayLink, '_blank')
        setLoading(false)
    }

    return (
        <div className="modal-overlay active" onClick={onClose}>
            <div className="modal" onClick={e => e.stopPropagation()}>
                <button onClick={onClose} className="absolute top-4 right-4 text-gray-400 hover:text-white">
                    <X className="w-6 h-6" />
                </button>
                <div className="text-center">
                    <div className="text-5xl mb-4">{prompt.icon}</div>
                    <h3 className="text-2xl font-bold mb-2">Unlock {prompt.name}</h3>
                    <div className="text-4xl font-bold mb-6 text-green-400">₹{prompt.price}</div>

                    <div className="mb-6">
                        <input
                            type="email"
                            placeholder="your@email.com"
                            value={email}
                            onChange={(e) => setEmail(e.target.value)}
                            required
                            className="w-full bg-dark-800 border border-white/10 rounded-xl py-3 px-4 text-white placeholder:text-gray-500 focus:outline-none focus:border-blue-500"
                        />
                    </div>

                    <button
                        onClick={handlePayment}
                        disabled={loading}
                        className="btn btn-primary w-full text-lg"
                    >
                        {loading ? '⏳ Loading...' : '💳 Pay with UPI / Card'}
                    </button>

                    <p className="text-xs text-gray-500 mt-4">
                        Supports UPI, Paytm, PhonePe, GPay, Cards
                    </p>
                </div>
            </div>
        </div>
    )
}

// MAIN
export default function Home() {
    const searchParams = useSearchParams()
    const [selectedPrompt, setSelectedPrompt] = useState < typeof PROMPTS[0] | null > (null)
    const [modalType, setModalType] = useState < 'free' | 'form' | 'paid' | null > (null)

    useEffect(() => {
        const ref = searchParams?.get('ref')
        if (ref) {
            sessionStorage.setItem('promptos_referrer', ref)
        }
    }, [searchParams])

    const handleUnlock = (id: number, type: string) => {
        const prompt = PROMPTS.find(p => p.id === id)
        if (prompt && type !== 'coming-soon') {
            setSelectedPrompt(prompt)
            setModalType(type as 'free' | 'form' | 'paid')
        }
    }

    const closeModal = () => {
        setSelectedPrompt(null)
        setModalType(null)
    }

    return (
        <main>
            <Navbar />
            <Hero />
            <HowItWorks />
            <PromptsSection onUnlock={handleUnlock} />
            <FAQ />
            <Footer />

            <FreeUnlockModal isOpen={modalType === 'free'} onClose={closeModal} prompt={selectedPrompt} />
            <FormUnlockModal isOpen={modalType === 'form'} onClose={closeModal} prompt={selectedPrompt} />
            <PaymentModal isOpen={modalType === 'paid'} onClose={closeModal} prompt={selectedPrompt} />
        </main>
    )
}

