        'use client'

import { useState } from 'react'
import { Copy, Download, Check, ArrowLeft } from 'lucide-react'
import Link from 'next/link'

interface UnlockClientProps {
    prompt: {
        name: string
        icon: string
        content: string
        formats?: Record<string, string>
    }
    promptId: number
}

export default function UnlockClient({ prompt, promptId }: UnlockClientProps) {
    const [copied, setCopied] = useState(false)
    const [selectedFormat, setSelectedFormat] = useState < string > ('base')

    const handleCopy = async () => {
        const contentToCopy = selectedFormat === 'base'
            ? prompt.content
            : prompt.formats?.[selectedFormat] || prompt.content

        await navigator.clipboard.writeText(contentToCopy)
        setCopied(true)
        setTimeout(() => setCopied(false), 2000)
    }

    const handleDownload = () => {
        const contentToDownload = selectedFormat === 'base'
            ? prompt.content
            : prompt.formats?.[selectedFormat] || prompt.content

        const blob = new Blob([contentToDownload], { type: 'text/plain' })
        const url = URL.createObjectURL(blob)
        const a = document.createElement('a')
        a.href = url
        a.download = `PromptOS-${prompt.name.replace(/\s+/g, '-')}-${selectedFormat}.txt`
        a.click()
