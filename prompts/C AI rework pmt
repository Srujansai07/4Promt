// src/app/api/referral/route.ts import { NextRequest, NextResponse } from 'next/server' import { kv } from '@vercel/kv' import { createHash } from 'crypto' // Generate unique referral ID from email function generateReferralId(email: string): string

// src/app/api/referral/route.ts
import { NextRequest, NextResponse } from 'next/server'
import { kv } from '@vercel/kv'
import { createHash } from 'crypto'

// Generate unique referral ID from email
function generateReferralId(email: string): string {
    return createHash('md5').update(email.toLowerCase()).digest('hex').slice(0, 12)
}

interface ReferralProgress {
    email: string
    referralId: string
    directReferrals: number // People they invited
    totalReferrals: number // Direct + indirect (their referrals' referrals)
    unlocked: boolean
    referralLink: string
    referredBy?: string
}

export async function POST(request: NextRequest) {
    try {
        const body = await request.json()
        const { action, email, referrerId, name } = body

        if (!email) {
            return NextResponse.json({ error: 'Email required' }, { status: 400 })
        }

        const userId = generateReferralId(email)

        // ACTION: Register user and create referral link
        if (action === 'register') {
            const existing = await kv.hgetall(`referral:${userId}`)

            if (!existing) {
                // Create new referral record
                await kv.hset(`referral:${userId}`, {
                    email,
                    name: name || '',
                    userId,
                    directReferrals: 0,
                    totalReferrals: 0,
                    unlocked: false,
                    createdAt: new Date().toISOString(),
                    referredBy: referrerId || ''
                })
            }

            const progress = await getProgress(userId)

            return NextResponse.json({
                success: true,
                referralId: userId,
                referralLink: `${process.env.NEXT_PUBLIC_APP_URL}/?ref=${userId}`,
                progress
            })
        }

        // ACTION: Track a referral
        if (action === 'track' && referrerId) {
            console.log('📊 Tracking referral:', { referrerId, newUser: email })

            // 1. Create record for new user
            await kv.hset(`referral:${userId}`, {
                email,
                userId,
                directReferrals: 0,
                totalReferrals: 0,
                unlocked: false,
                createdAt: new Date().toISOString(),
                referredBy: referrerId
            })

            // 2. Increment referrer's direct count
            await kv.hincrby(`referral:${referrerId}`, 'directReferrals', 1)
            await kv.hincrby(`referral:${referrerId}`, 'totalReferrals', 1)

            // 3. Get referrer's parent and increment their total (2-level tracking)
            const referrerData = await kv.hgetall(`referral:${referrerId}`)
            if (referrerData?.referredBy) {
                const parentId = referrerData.referredBy as string
                await kv.hincrby(`referral:${parentId}`, 'totalReferrals', 1)

                // Check if parent unlocked tier 3
                const parentProgress = await getProgress(parentId)
                if (parentProgress.totalReferrals >= 9 && !parentProgress.unlocked) {
                    await kv.hset(`referral:${parentId}`, { unlocked: true })

                    // Grant Tier 3 access
                    const parentEmail = parentProgress.email
                    await kv.hset(`user:${parentEmail}`, {
                        'prompt:3': 'unlocked',
                        'unlock_method': 'referral',
                        'unlock_date:3': new Date().toISOString()
                    })

                    console.log('🎉 User unlocked Tier 3 via referrals:', parentEmail)
                }
            }

            // 4. Check if referrer unlocked tier 3
            const progress = await getProgress(referrerId)
            if (progress.totalReferrals >= 9 && !progress.unlocked) {
                await kv.hset(`referral:${referrerId}`, { unlocked: true })

                // Grant access
                await kv.hset(`user:${progress.email}`, {
                    'prompt:3': 'unlocked',
                    'unlock_method': 'referral',
                    'unlock_date:3': new Date().toISOString()
                })

                console.log('🎉 User unlocked Tier 3 via referrals:', progress.email)
            }

            return NextResponse.json({
                success: true,
                message: 'Referral tracked',
                progress
            })
        }

        return NextResponse.json({ error: 'Invalid action' }, { status: 400 })

    } catch (error) {
        console.error('❌ Referral error:', error)
        return NextResponse.json(
            { error: 'Internal server error' },
            { status: 500 }
        )
    }
}

export async function GET(request: NextRequest) {
    try {
        const { searchParams } = new URL(request.url)
        const userId = searchParams.get('userId')

        if (userId) {
            const progress = await getProgress(userId)
            return NextResponse.json({ progress })
        }

        // Get global stats
        const keys = await kv.keys('referral:*')
        const stats = {
            totalUsers: keys.length,
            totalUnlocked: 0
        }

        return NextResponse.json(stats)

    } catch (error) {
        console.error('❌ Referral GET error:', error)
        return NextResponse.json({ error: 'Failed to fetch stats' }, { status: 500 })
    }
}

// Helper function
async function getProgress(userId: string): Promise<ReferralProgress> {
    const data = await kv.hgetall(`referral:${userId}`) || {}

    return {
        email: data.email as string || '',
        referralId: userId,
        directReferrals: Number(data.directReferrals) || 0,
        totalReferrals: Number(data.totalReferrals) || 0,
        unlocked: Boolean(data.unlocked),
        referralLink: `${process.env.NEXT_PUBLIC_APP_URL}/?ref=${userId}`,
        referredBy: data.referredBy as string
    }
}

