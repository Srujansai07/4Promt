# PromptOS Environment Variables

# Razorpay (Indian Payment Gateway)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET_KEY=your_super_secret_random_string_min_32_chars

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Vercel KV (Auto-injected by Vercel, but for local testing)
# Get by running: vercel env pull .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# Email (Optional - Resend)
RESEND_API_KEY=re_YOUR_KEY_HERE

# ARCHIVED: Stripe and Gumroad env vars moved to archive
# See src/archive/ for previous payment gateway code
